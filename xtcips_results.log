done: imf_fm_access_z
done: imf_fm_depth_z
done: imf_fm_efficiency_z
done: hydro_consumption_pc_z
done: solar_consumption_pc_z
done: wind_consumption_pc_z
done: other_renewable_consumption_pc_z

. capture drop __x __nmis __sd __ok __t1 __t2

. postclose `H'

